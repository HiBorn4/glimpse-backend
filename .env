# Wedding Photo AI — Backend Environment Variables
# Copy this file to .env and fill in your values.

# ── Required: Cloudflare R2 ───────────────────────────────────────────────────
# Public URL of your R2 bucket (Cloudflare custom domain or r2.dev URL)
# R2_PUBLIC_URL=https://pub-d71190a04d1b49a19bbcda03a2ffae01.r2.dev
R2_PUBLIC_URL=https://pub-a5935e114e294693b3bbc72805606149.r2.dev

# Top-level folder prefix inside your bucket
# R2_EVENT_PREFIX=sanket-weds-vrutika-2026

R2_EVENT_PREFIX=sanket-weds-vrutika-2026

# ── Optional: R2 credentials (only needed if you use signed URLs or API writes)
R2_ACCOUNT_ID=ab267e139e9fe11236027427115b119a
R2_ACCESS_KEY=4850f36f9260611417fb8b5d59a6de7e
R2_SECRET_KEY=d1bc096f33dc7b99550794d87059ec2fdd2a7740d75912f2ff44d032ddadf078

R2_BUCKET_NAME=sanket-weds-vrutika-2026

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ENV=dev   # set to "prod" for production (disables reload, enables 4 workers)

# ── Frontend URL (for CORS) ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Face Search ───────────────────────────────────────────────────────────────
SEARCH_THRESHOLD=0.35   # lower = more lenient matches
SEARCH_TOP_K=3
USE_GPU=false           # set to true if you have CUDA available

